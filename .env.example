# Email Configuration for Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_TO_EMAIL=your-email@gmail.com
# GitHub Blog Configuration
# Get your token from: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here



# Your GitHub username
GITHUB_USERNAME=your_github_username

# Your GitHub repository name (where blogs folder is located)
GITHUB_REPO=your_repository_name

# Optional: API base URL (defaults to GitHub)
# GITHUB_API_BASE=https://api.github.com

# Optional: Blog folder path in the repository (defaults to "blogs")
# BLOG_FOLDER=blogs
